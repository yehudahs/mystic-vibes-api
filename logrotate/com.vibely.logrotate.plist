<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vibely.logrotate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/sbin/logrotate</string>
        <string>/Users/yehuda/priavte/mystic-vibes/mystic-vibes-api/logrotate/vibely.conf</string>
        <string>--state</string>
        <string>/Users/yehuda/priavte/mystic-vibes/mystic-vibes-api/logrotate/logrotate.state</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/vibely-logrotate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vibely-logrotate.log</string>
</dict>
</plist>
