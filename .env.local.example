# Backend Local Environment Overrides
# Copy to .env.local and customize for your local development
# .env.local is gitignored and won't be committed

# Database Override (if using different local setup)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=my_local_vibely_db
# DB_USER=my_user
# DB_PASSWORD=my_password

# Authentication Override
# JWT_SECRET=my-local-jwt-secret-for-testing

# Stripe Override (your personal test keys)
# STRIPE_SECRET_KEY=sk_test_your_personal_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_personal_webhook_secret

# External API Keys (your personal keys for testing)
# OPENAI_API_KEY=your-personal-openai-key
# ANTHROPIC_API_KEY=your-personal-anthropic-key

# Resend (transactional email)
# RESEND_API_KEY=re_...
# SUPPORT_EMAIL=yehudahs@mystic-vibes.com

# Email Override (for local email testing)
# EMAIL_SERVICE=development
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Debug Overrides
# LOG_LEVEL=debug
# ENABLE_REQUEST_LOGGING=true