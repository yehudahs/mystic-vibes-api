# Backend Production Environment
# Copy this to Railway environment variables
# ⚠️ WARNING: Use LIVE Stripe keys - REAL PAYMENTS!

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration (Railway Postgres)
# Railway will auto-inject DATABASE_URL
DATABASE_URL=${{Postgres.DATABASE_URL}}

# JWT Authentication — REQUIRED, must be >=32 chars; rotate to invalidate all sessions.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-production-jwt-secret-here-change-me-to-strong-random
JWT_EXPIRES_IN=7d

# Google OAuth — REQUIRED to enable Google sign-in.
# Must match the OAuth Client ID used by the frontend (VITE_GOOGLE_CLIENT_ID).
# The API verifies every Google ID token against this audience.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Shared secret between this API and the AI gateway (AI-service Node proxy).
# Sent as X-Service-Auth on every request to AI_SERVICES.
# Must match SERVICE_AUTH_KEY on the AI-service side.
# Generate with: openssl rand -hex 32
AI_SERVICES=https://ai.mystic-vibes.com
AI_SERVICES_KEY=your-shared-secret-here-min-16-chars

# Stripe LIVE Mode Configuration
# ⚠️ REAL PAYMENTS! Double check these keys!
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here

# AI Configuration
AI_PROVIDER=ollama

# Ollama Configuration
# For production, use a stable remote instance or hosted service
OLLAMA_BASE_URL=https://your-ollama-production.yourdomain.com
# OLLAMA_MODEL is intentionally not set here — the API never reads it.
# The model is configured on the host that runs the AI gateway, in
# AI-service/.env (single source of truth).

# Frontend URL for CORS
FRONTEND_URL=https://your-production-frontend.railway.app

# Optional: OpenAI fallback
# OPENAI_API_KEY=sk-your-openai-key

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key
SUPPORT_EMAIL=yehudahs@mystic-vibes.com
