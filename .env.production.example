# Backend Production Environment
# Copy this to Railway environment variables
# ⚠️ WARNING: Use LIVE Stripe keys - REAL PAYMENTS!

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration (Railway Postgres)
# Railway will auto-inject DATABASE_URL
DATABASE_URL=${{Postgres.DATABASE_URL}}

# JWT Authentication
JWT_SECRET=your-production-jwt-secret-here-change-me-to-strong-random
JWT_EXPIRES_IN=7d

# Stripe LIVE Mode Configuration
# ⚠️ REAL PAYMENTS! Double check these keys!
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here

# AI Configuration
AI_PROVIDER=ollama

# Ollama Configuration
# For production, use a stable remote instance or hosted service
OLLAMA_BASE_URL=https://your-ollama-production.yourdomain.com
OLLAMA_MODEL=llama3.2:3b

# Frontend URL for CORS
FRONTEND_URL=https://your-production-frontend.railway.app

# Optional: OpenAI fallback
# OPENAI_API_KEY=sk-your-openai-key

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key
SUPPORT_EMAIL=yehudahs@mystic-vibes.com
