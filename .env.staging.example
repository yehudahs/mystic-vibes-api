# Backend Staging Environment
# Copy this to Railway environment variables

# Server Configuration
PORT=3001
NODE_ENV=staging

# Database Configuration (Railway Postgres)
# Railway will auto-inject DATABASE_URL
DATABASE_URL=${{Postgres.DATABASE_URL}}

# JWT Authentication
JWT_SECRET=your-staging-jwt-secret-here-change-me
JWT_EXPIRES_IN=7d

# Stripe Test Mode Configuration
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_staging_webhook_secret_here

# AI Configuration
AI_PROVIDER=ollama

# Ollama Configuration
# For staging, you might want to use a remote Ollama instance
OLLAMA_BASE_URL=https://your-ollama-staging.ngrok-free.dev
OLLAMA_MODEL=llama3.2:3b

# Frontend URL for CORS
FRONTEND_URL=https://your-staging-frontend.railway.app

# Optional: OpenAI fallback
# OPENAI_API_KEY=sk-your-openai-key
